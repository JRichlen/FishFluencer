venv/

# Runtime data (anchored to repo root — do NOT match src/data/)
/data/
/logs/*
!/logs/.gitkeep

# Snapshots — privacy critical, never commit
/data/snapshots/

# Local secrets (defense in depth — real secrets live in systemd env)
.env
.env.local

# OS / editor
.DS_Store
.vscode/
.idea/
